{
  "name": "aws-ssa",
  "version": "1.0.0",
  "private": true,
  "description": "AWS SAA 刷题平台 monorepo：React 主站 + FastAPI(Python) 后端 + MySQL",
  "scripts": {
    "dev:api": "cd apps/api && uvicorn main:app --reload --app-dir src --port 8000",
    "dev:web": "pnpm --filter @aws-ssa/web dev",
    "build": "pnpm --filter @aws-ssa/web build",
    "install:api": "pip3 install -r apps/api/requirements.txt"
  },
  "engines": { "node": ">=20" }
}
